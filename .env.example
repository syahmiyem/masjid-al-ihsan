# Copy to apps/web/.env (site) and apps/studio/.env (Studio) for local work. Never commit real .env files.

# --- apps/web ---
# Public address used for canonical URLs, sitemap, share images and .ics links (docs/plan.md 9.6).
# UAT: https://masjid-al-ihsan.<subdomain>.workers.dev   Production: https://<custom domain>
SITE_URL=http://localhost:4321
# Test-site mode: "Laman Percubaan" banner + noindex. Defaults to true; set false only at go-live.
UAT_MODE=true
SANITY_PROJECT_ID=
SANITY_DATASET=production

# --- apps/studio ---
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_HOST=masjid-al-ihsan

# --- CI only (GitHub Actions secrets, never in files) ---
# CLOUDFLARE_API_TOKEN   account-owned token: Workers Scripts:Edit (+ R2 for backups)
# CLOUDFLARE_ACCOUNT_ID
# SANITY_AUTH_TOKEN      Sanity project (robot) token for studio deploy / backups
