#!/bin/sh
# Local checks before every push (replaces GitHub Actions CI — docs/plan.md D-76).
# Skip in an emergency with: git push --no-verify
set -e
echo "pre-push: format, type-check, tests…"
pnpm -s format:check
pnpm -s check >/dev/null
pnpm -s test >/dev/null
node scripts/waktu-solat/coverage.ts
node apps/web/scripts/check-derma.ts
echo "pre-push: OK"
