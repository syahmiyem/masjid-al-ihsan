---
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import { UAT_MODE } from 'astro:env/server';
import BottomNav from '../components/ui/BottomNav.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import UatBanner from '../components/UatBanner.astro';
import { cssVariables } from '../design/tokens';
import { ogFor } from '../poster/catalogue';
import '../styles.css';

interface Props {
  title: string;
  description?: string;
  /** Site header + mobile bottom bar. Off for pages that exist before the full site does. */
  withNav?: boolean;
  /** Link-preview image (plan 4.4); per-page share images arrive in Phase 3 */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, withNav = false, ogType = 'website' } = Astro.props;
const ogImage =
  Astro.props.ogImage ?? (await ogFor(Astro.url.pathname.replace(/\/$/, '') || '/')) ?? '/og-default.png';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ms">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Masjid Al-Ihsan" />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Masjid Al-Ihsan, Felda Sg Panching Selatan, Kuantan" />
    <meta name="twitter:card" content="summary_large_image" />
    {UAT_MODE && <meta name="robots" content="noindex, nofollow" />}
    <style is:inline set:html={`:root{${cssVariables()}}`} />
  </head>
  <body class:list={{ 'has-bottom-nav': withNav }}>
    <a class="skip-link" href="#kandungan">
      Langkau ke kandungan
    </a>
    {UAT_MODE && <UatBanner />}
    {withNav && <SiteHeader />}
    <main id="kandungan" class="container">
      <slot />
    </main>
    {withNav && <SiteFooter />}
    {withNav && <BottomNav />}
  </body>
</html>

<style>
  .has-bottom-nav {
    padding-bottom: calc(var(--nav-h) + env(safe-area-inset-bottom));
  }
  @media (min-width: 60rem) {
    .has-bottom-nav {
      padding-bottom: 0;
    }
  }
</style>
