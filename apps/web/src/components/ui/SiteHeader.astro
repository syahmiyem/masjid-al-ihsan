---
// Header: mosque name (links home) + a labelled "Menu" button (plan 3.2) that opens a full-screen menu
// (D-55). Built on <details>, so it works without JavaScript; a small script adds Escape-to-close, keeps
// keyboard focus inside the menu (inert background) and stops the page scrolling behind it.
import { Menu, X } from '@lucide/astro';
import NavIcon from './NavIcon.astro';
import { MENU_NAV, PRIMARY_NAV, isCurrent } from './nav';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/">
      <span class="name">Masjid Al-Ihsan</span>
      <span class="place">Felda Sg Panching Selatan</span>
    </a>
    <nav class="desktop-nav" aria-label="Utama">
      {PRIMARY_NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <details class="menu">
      <summary class="menu-button">
        <span class="when-closed">
          <Menu size={22} aria-hidden="true" /> Menu
        </span>
        <span class="when-open">
          <X size={22} aria-hidden="true" /> Tutup
        </span>
      </summary>
      <div class="overlay">
        <nav class="menu-panel" aria-label="Menu">
          <ul>
            {MENU_NAV.map((item, i) => (
              <li style={`--i:${i}`}>
                <a href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
                  <NavIcon name={item.icon} size={28} />
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="menu-foot">Masjid Al-Ihsan · Felda Sg Panching Selatan, Kuantan</p>
        </nav>
      </div>
    </details>
  </div>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('details.menu')) {
    const summary = menu.querySelector('summary')!;
    // Everything outside the header becomes inert while the menu is open, so Tab stays in the menu
    const outside = () =>
      [...document.body.children].filter(
        (el) => !el.contains(menu) && el.tagName !== 'SCRIPT',
      ) as HTMLElement[];
    menu.addEventListener('toggle', () => {
      document.documentElement.classList.toggle('menu-open', menu.open);
      for (const el of outside()) el.inert = menu.open;
      if (menu.open) menu.querySelector<HTMLElement>('.menu-panel a')?.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        document.documentElement.classList.remove('menu-open');
        for (const el of outside()) el.inert = false;
        summary.focus();
      }
    });
  }
</script>

<style>
  /* While the menu is open the header is pinned to the top, above the full-screen overlay
     (works with or without the test-site banner above it) */
  .site-header:has(details.menu[open]) {
    position: fixed;
    inset: 0 0 auto 0;
  }
  .site-header {
    position: relative;
    z-index: 60;
    background: var(--c-primary);
    color: var(--c-on-primary);
    border-bottom: 4px solid var(--c-accent);
    view-transition-name: site-header; /* stays put during page transitions */
  }
  .inner {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--c-on-primary);
    margin-right: auto;
    min-height: var(--tap);
    justify-content: center;
    position: relative;
    z-index: 2;
  }
  .name {
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.15;
  }
  .place {
    font-size: 1rem;
    font-weight: 400;
    color: var(--c-primary-soft);
  }

  /* Menu button: same place as before; gold, and becomes "Tutup" when open */
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-button {
    position: relative;
    z-index: 2; /* above the full-screen overlay so it can close it */
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: var(--c-primary);
    font-weight: 700;
    cursor: pointer;
    border: 2px solid var(--c-accent);
  }
  .menu-button span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .menu-button:focus-visible {
    outline: 3px solid var(--c-on-primary);
    box-shadow: 0 0 0 6px var(--c-accent);
  }
  .menu-button .when-open,
  .menu[open] .menu-button .when-closed {
    display: none;
  }
  .menu[open] .menu-button .when-open {
    display: inline-flex;
  }
  .menu[open] .menu-button {
    background: var(--c-primary-soft);
    border-color: var(--c-primary-soft);
  }

  /* Full-screen menu (D-55) */
  .menu::details-content {
    /* opt out of the generic <details> height animation; the overlay animates itself */
    block-size: auto;
    opacity: 1;
    transition: none;
  }
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--c-primary);
    color: var(--c-on-primary);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6.75rem 1.25rem calc(2rem + env(safe-area-inset-bottom));
  }
  .menu-panel {
    max-width: 32rem;
    margin: 0 auto;
  }
  .menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-panel li + li {
    border-top: 1px solid rgb(253 241 211 / 0.18);
  }
  .menu-panel a {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    color: var(--c-primary-soft);
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none;
  }
  .menu-panel a :global(svg) {
    color: var(--c-accent);
    flex: none;
  }
  .menu-panel a:hover,
  .menu-panel a[aria-current='page'] {
    background: rgb(253 241 211 / 0.1);
    color: var(--c-accent);
  }
  .menu-panel a[aria-current='page'] {
    box-shadow: inset 4px 0 0 var(--c-accent);
  }
  .menu-panel a:focus-visible {
    outline: 3px solid var(--c-accent);
    box-shadow: none;
  }
  .menu-foot {
    margin: 2rem 0 0;
    color: var(--c-primary-soft);
    font-size: 1rem;
  }
  :global(html.menu-open) {
    overflow: hidden; /* no page scrolling behind the menu */
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .overlay {
      animation: overlay-in 260ms var(--ease) both;
    }
    .menu[open] .menu-panel li {
      animation: item-in 340ms var(--ease) both;
      animation-delay: calc(60ms + var(--i) * 35ms);
    }
    .menu-button {
      transition:
        background-color var(--fast) var(--ease),
        transform var(--fast) var(--ease);
    }
    .menu-button:active {
      transform: scale(0.96);
    }
  }
  @keyframes overlay-in {
    from {
      opacity: 0;
      clip-path: circle(0% at calc(100% - 3rem) 2.2rem);
    }
    to {
      opacity: 1;
      clip-path: circle(150% at calc(100% - 3rem) 2.2rem);
    }
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .desktop-nav {
    display: none;
  }
  @media (min-width: 60rem) {
    .desktop-nav {
      display: flex;
      gap: 0.25rem;
    }
    .desktop-nav a {
      padding: 0.6rem 0.9rem;
      border-radius: var(--radius);
      text-decoration: none;
      font-weight: 700;
      color: var(--c-primary-soft);
    }
    .desktop-nav a:hover,
    .desktop-nav a[aria-current='page'] {
      color: var(--c-accent);
      background: rgb(253 241 211 / 0.1);
    }
    .desktop-nav a:focus-visible {
      outline: 3px solid var(--c-accent);
      box-shadow: none;
    }
  }
</style>
