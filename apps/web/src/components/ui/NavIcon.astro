---
import { BookOpen, CalendarDays, Clock, HandHeart, House, Landmark, Phone, Users } from '@lucide/astro';
import type { NavIcon } from './nav';

interface Props {
  name: NavIcon;
  size?: number;
}
const { name, size = 24 } = Astro.props;
const icons = { BookOpen, CalendarDays, Clock, HandHeart, House, Landmark, Phone, Users };
const Icon = icons[name];
---

<Icon size={size} aria-hidden="true" stroke-width={2} />
