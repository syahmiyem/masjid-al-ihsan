---
// Mobile bottom bar: 4 items, icon + text label, always visible (plan 3.2, D-04).
import NavIcon from './NavIcon.astro';
import { PRIMARY_NAV, isCurrent } from './nav';

const path = Astro.url.pathname;
---

<nav class="bottom-nav" aria-label="Navigasi utama">
  <ul>
    {PRIMARY_NAV.map((item) => (
      <li>
        <a href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
          <NavIcon name={item.icon} />
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    background: var(--c-bg);
    border-top: 1px solid var(--c-border);
    padding-bottom: env(safe-area-inset-bottom);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  li {
    /* Widths follow label length so "Perkhidmatan" fits at 16px on a 360px screen */
    flex: 1 1 auto;
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: var(--nav-h);
    padding: 0.35rem 0.25rem;
    color: var(--c-text);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.2;
  }
  a[aria-current='page'] {
    background: var(--c-primary-soft);
    font-weight: 700;
    box-shadow: inset 0 3px 0 var(--c-primary);
  }
  /* Too narrow for the text size (e.g. 320px phone with the largest system font): 2 × 2 grid,
     icon beside label, rather than breaking words. Em-based so it follows the user's font size. */
  @media (max-width: 19.5em) {
    ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    a {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.5rem;
      min-height: 3rem;
      padding: 0.25rem 0.75rem;
    }
  }
  @media (min-width: 60rem) {
    .bottom-nav {
      display: none;
    }
  }
</style>
