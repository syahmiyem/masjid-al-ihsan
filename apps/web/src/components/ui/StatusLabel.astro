---
// Status shown as colour AND words, never colour alone (WCAG 1.4.1; plan 4.1).
export type Status = 'dijadualkan' | 'dipinda' | 'ditangguhkan' | 'dibatalkan' | 'berlangsung';

interface Props {
  status: Status;
  text?: string;
}
const { status, text } = Astro.props;
const labels: Record<Status, string> = {
  dijadualkan: '',
  dipinda: 'DIPINDA',
  ditangguhkan: 'DITANGGUHKAN',
  dibatalkan: 'DIBATALKAN',
  berlangsung: 'Telah berlangsung',
};
const label = text ?? labels[status];
---

{label && <span class={`status status-${status}`}>{label}</span>}

<style>
  .status {
    display: inline-block;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
    border: 1px solid currentColor;
  }
  .status-dibatalkan {
    background: var(--c-cancelled-bg);
    color: var(--c-cancelled-text);
  }
  .status-ditangguhkan {
    background: var(--c-postponed-bg);
    color: var(--c-postponed-text);
  }
  .status-dipinda {
    background: var(--c-changed-bg);
    color: var(--c-changed-text);
  }
  .status-berlangsung {
    background: var(--c-past-bg);
    color: var(--c-past-text);
    letter-spacing: 0;
  }
</style>
