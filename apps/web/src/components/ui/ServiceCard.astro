---
// Service card on the home page and /perkhidmatan (plan 3.3, 4.3).
import { ChevronRight } from '@lucide/astro';

interface Props {
  name: string;
  summary: string;
  href: string;
}
const { name, summary, href } = Astro.props;
---

<a class="service card" href={href}>
  <span class="text">
    <span class="name">{name}</span>
    <span class="summary">{summary}</span>
  </span>
  <ChevronRight size={28} aria-hidden="true" />
</a>

<style>
  .service {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--c-text);
    min-height: 5rem;
  }
  .service:hover {
    border-color: var(--c-primary);
    box-shadow: inset 0 0 0 1px var(--c-primary);
  }
  .text {
    display: flex;
    flex-direction: column;
    margin-right: auto;
  }
  .name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--c-primary);
  }
  .summary {
    color: var(--c-text-muted);
  }
</style>
