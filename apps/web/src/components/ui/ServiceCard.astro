---
// Service card on the home page and /perkhidmatan (plan 3.3, 4.3).
import { ChevronRight } from '@lucide/astro';

interface Props {
  name: string;
  summary: string;
  href: string;
}
const { name, summary, href } = Astro.props;
---

<a class="service card reveal" href={href}>
  <span class="text">
    <span class="name">{name}</span>
    <span class="summary">{summary}</span>
  </span>
  <ChevronRight size={28} aria-hidden="true" />
</a>

<style>
  .service {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--c-text);
    min-height: 5rem;
  }
  .service:hover {
    border-color: var(--c-primary);
    box-shadow: inset 4px 0 0 var(--c-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .service {
      transition:
        box-shadow var(--med) var(--ease),
        border-color var(--med) var(--ease),
        transform var(--med) var(--ease);
    }
    .service:hover {
      transform: translateY(-2px);
    }
  }
  .text {
    display: flex;
    flex-direction: column;
    margin-right: auto;
  }
  .name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--c-primary);
  }
  .summary {
    color: var(--c-text-muted);
  }
</style>
