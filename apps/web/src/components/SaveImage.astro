---
// "Simpan Gambar" (plan 4.4): preview each generated image with "Muat Turun" (always works) and
// "Kongsi" (sends the image file via the device share sheet where supported — checked with canShare).
import { Download, ImageDown, Share2 } from '@lucide/astro';
import { FORMATS } from '../poster/frame';
import { postersFor } from '../poster/catalogue';

interface Props {
  page: string;
}
const posters = await postersFor(Astro.props.page);
const fileName = (path: string) => `masjid-al-ihsan-${path.replace(/^\/gambar\//, '').replace(/\//g, '-')}`;
const label = (p: (typeof posters)[number]) =>
  `${FORMATS[p.format].label}${p.parts > 1 ? ` · ${p.part}/${p.parts}` : ''}`;
---

{posters.length > 0 && (
  <details class="save-image">
    <summary class="btn btn-secondary">
      <ImageDown size={22} aria-hidden="true" /> Simpan Gambar
    </summary>
    <p class="muted">
      Gambar untuk dikongsi di WhatsApp dan media sosial. Pilih <strong>Potret</strong> untuk kiriman biasa
      atau <strong>Status WhatsApp</strong> untuk status.
    </p>
    <p class="ios-hint" hidden>
      Tekan <strong>Simpan / Kongsi</strong>, kemudian pilih <strong>Simpan Imej</strong> untuk simpan ke
      Foto, atau pilih WhatsApp.
    </p>
    <p class="ios-hint-old" hidden>
      Tekan <strong>Buka Gambar</strong>, kemudian tekan lama pada gambar dan pilih{' '}
      <strong>Tambah ke Foto</strong>.
    </p>
    <ul>
      {posters.map((p) => (
        <li>
          <a href={p.path} class="thumb">
            <img
              src={p.path}
              alt={`Pratonton gambar: ${p.title}, ${label(p)}`}
              width={FORMATS[p.format].width}
              height={FORMATS[p.format].height}
              loading="lazy"
              decoding="async"
            />
          </a>
          <span class="label">
            {p.title}
            <span class="format">{label(p)}</span>
          </span>
          <a class="btn btn-secondary small" href={p.path} download={fileName(p.path)} data-download>
            <Download size={20} aria-hidden="true" /> Muat Turun
          </a>
          <button
            class="btn btn-primary small"
            type="button"
            data-share-file={p.path}
            data-name={fileName(p.path)}
            hidden
          >
            <Share2 size={20} aria-hidden="true" /> Kongsi
          </button>
        </li>
      ))}
    </ul>
  </details>
)}

<script>
  // "Kongsi" appears only where the browser can share image files (plan 4.4 browser note).
  // iPhone/iPad: <a download> can stall in Safari's Downloads list and saves to Files, where older users
  // won't find it — so on iOS, saving goes through the share sheet ("Simpan Imej" saves to Photos).
  const isIOS =
    /iP(hone|ad|od)/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const probe = new File([new Uint8Array([0])], 'probe.png', { type: 'image/png' });
  const canShareFiles = Boolean(navigator.canShare?.({ files: [probe] }));

  // Fetch images when the panel opens, so share() runs straight after the tap (Safari needs a recent tap)
  const files = new Map<string, Promise<File>>();
  const fileFor = (path: string, name: string) => {
    if (!files.has(path)) {
      files.set(
        path,
        fetch(path)
          .then((r) => r.blob())
          .then((blob) => new File([blob], name, { type: 'image/png' })),
      );
    }
    return files.get(path)!;
  };

  for (const panel of document.querySelectorAll<HTMLDetailsElement>('details.save-image')) {
    const buttons = [...panel.querySelectorAll<HTMLButtonElement>('[data-share-file]')];
    const downloads = [...panel.querySelectorAll<HTMLAnchorElement>('[data-download]')];

    if (canShareFiles) {
      panel.addEventListener('toggle', () => {
        if (panel.open) for (const b of buttons) void fileFor(b.dataset.shareFile!, b.dataset.name!);
      });
      for (const button of buttons) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          try {
            await navigator.share({
              files: [await fileFor(button.dataset.shareFile!, button.dataset.name!)],
            });
          } catch {
            /* cancelled — nothing to do */
          }
        });
      }
    }

    if (isIOS) {
      if (canShareFiles) {
        // One button does both: the share sheet offers "Simpan Imej" (Photos) and WhatsApp
        for (const a of downloads) a.hidden = true;
        for (const b of buttons) b.lastChild!.textContent = ' Simpan / Kongsi';
        panel.querySelector<HTMLElement>('.ios-hint')!.hidden = false;
      } else {
        // Older iOS without file sharing: open the image; long-press → "Tambah ke Foto"
        for (const a of downloads) {
          a.removeAttribute('download');
          a.target = '_blank';
          a.rel = 'noopener';
          a.lastChild!.textContent = ' Buka Gambar';
        }
        panel.querySelector<HTMLElement>('.ios-hint-old')!.hidden = false;
      }
    }
  }
</script>

<style>
  .save-image {
    margin-top: var(--s1);
  }
  .save-image summary {
    list-style: none;
  }
  .save-image summary::-webkit-details-marker {
    display: none;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: var(--s1) 0 0;
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, 8.25rem), 1fr)
    ); /* two per row on a 360px phone */
    gap: var(--s2);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .label {
    display: flex;
    flex-direction: column;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
  }
  .format {
    font-weight: 400;
    color: var(--c-text-muted);
  }
  .ios-hint,
  .ios-hint-old {
    font-weight: 700;
  }
  .small {
    padding: 0.4rem 0.6rem;
    font-size: 1rem;
  }
</style>
